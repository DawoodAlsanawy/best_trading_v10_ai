# ═══════════════════════════════════════════════════════════════════════════
#  Trading Bot — Environment File
#  ⚠️  DO NOT COMMIT THIS FILE. Add `.env` to your .gitignore.
#  ═══════════════════════════════════════════════════════════════════════════

# ── Trading Mode ──
# Values: backtest | testnet | live
MODE=live

# ── Binance API Credentials ──
# Live keys:    https://www.binance.com/en/my/settings/api-management
# Testnet keys: https://testnet.binancefuture.com/
BINANCE_API_KEY=PASTE_YOUR_API_KEY_HERE
BINANCE_API_SECRET=PASTE_YOUR_API_SECRET_HERE
